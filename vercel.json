{
  "crons": [
    {
      "path": "/api/dialpad/cron?store=fishers",
      "schedule": "0 12-23 * * *"
    },
    {
      "path": "/api/dialpad/cron?store=bloomington",
      "schedule": "10 12-23 * * *"
    },
    {
      "path": "/api/dialpad/cron?store=indianapolis",
      "schedule": "20 12-23 * * *"
    },
    {
